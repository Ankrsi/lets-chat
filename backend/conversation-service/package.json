{
  "name": "superapp-event-server",
  "version": "1.0.0",
  "description": "Server for handling Events",
  "main": "index.js",
  "bin": {
    "express-template-ts": "bin/cli.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc",
    "swagger": "ts-node swagger/swagger-autogen.ts",
    "seed:chat-metrics": "ts-node src/script/seedChatMetrics.ts",
    "dev": "nodemon --exec ts-node ./index.ts",
    "lint": "eslint \"src/**/*.{js,ts}\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.{js,ts}\" --fix",
    "format": "prettier --write \"src/**/*.{js,ts,json,md}\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1003.0",
    "@aws-sdk/s3-request-presigner": "^3.1003.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/express": "^4.17.22",
    "@types/pdfkit": "^0.17.5",
    "aws-sdk": "^2.1692.0",
    "axios": "1.14.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-basic-auth": "^1.2.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "i18next": "^26.0.1",
    "i18next-fs-backend": "^2.6.1",
    "ioredis": "^5.6.1",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "libphonenumber-js": "^1.12.34",
    "mediasoup": "^3.19.13",
    "mongoose": "^6.13.8",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "pdfkit": "^0.17.2",
    "pm2": "^6.0.14",
    "prom-client": "^15.1.3",
    "redis": "^5.5.6",
    "socket.io": "^4.8.1",
    "swagger-autogen": "^2.23.7",
    "swagger-ui-express": "^5.0.1",
    "types": "^0.1.1",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/hpp": "^0.2.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.14.2",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "bun": "^1.1.20",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "nodemon": "^3.1.3",
    "prettier": "^3.6.2",
    "prisma": "^6.16.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "author": "rahul arya",
  "license": "ISC"
}
