{
  "compilerOptions": {
    "outDir": "./dist",
    "allowJs": true,
    "typeRoots": [
      "./node_modules/@types",
      "./types"
    ],
    "moduleResolution": "node16",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "target": "es2016",
    "experimentalDecorators": true,
    "module": "Node16",
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "src",
    "types",
    "index.ts"
, "swagger"  ]
}