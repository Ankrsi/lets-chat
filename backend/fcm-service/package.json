{
  "name": "superapp-fcm-service",
  "version": "1.0.0",
  "description": "microservice for fcm service",
  "main": "index.js",
  "bin": {
    "express-template-ts": "bin/cli.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc ",
    "dev": "nodemon --exec ts-node ./index.ts",
    "lint": "eslint \"src/**/*.{js,ts}\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.{js,ts}\" --fix",
    "format": "prettier --write \"src/**/*.{js,ts,json,md}\""
  },
  "dependencies": {
    "apn": "^2.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "firebase-admin": "^13.4.0",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/apn": "^0.0.31",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/hpp": "^0.2.6",
    "@types/node": "^20.19.6",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "nodemon": "^3.1.3",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "author": "rahul arya",
  "license": "ISC"
}
