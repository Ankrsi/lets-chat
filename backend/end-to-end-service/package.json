{
  "name": "end-to-end-service",
  "version": "1.0.0",
  "description": "microservice for end to end server",
  "main": "index.js",
  "bin": {
    "express-template-ts": "bin/cli.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc",
    "copy-static": "cp -r public dist/",
    "dev": "nodemon --exec ts-node ./index.ts",
    "setup-indexes": "NODE_ENV=production node dist/src/scripts/setupIndexes.js",
    "lint": "eslint \"src/**/*.{js,ts}\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.{js,ts}\" --fix",
    "format": "prettier --write \"src/**/*.{js,ts,json,md}\""
  },
  "dependencies": {
    "@types/express": "^4.17.22",
    "axios": "^1.9.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.1.0",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.3",
    "libsignal-protocol": "^1.3.15",
    "mongodb": "^6.7.0",
    "mongoose": "^8.15.0",
    "multer": "^2.0.0",
    "types": "^0.1.1",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/hpp": "^0.2.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.2",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "bun": "^1.1.20",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "nodemon": "^3.1.3",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "author": "rahul arya",
  "license": "ISC"
}
